<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/pipet_button"
        android:layout_width="wrap_content"
        android:layout_height="89dp"
        android:onClick="PipetButton"
        android:textSize="16sp"
        app:icon="@drawable/pipetka"
        app:iconTint="#FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/customView"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customView">

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:onClick="ToTextButton"
            android:text="текст"
            tools:layout_editor_absoluteX="147dp"
            tools:layout_editor_absoluteY="254dp" />

        <Button
            android:id="@+id/tetrisButton2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:onClick="TetrisButton"
            android:text="ігри" />

    </LinearLayout>

    <ToggleButton
        android:id="@+id/toggleFill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/workbutton"
        android:text="ToggleButton"
        android:textColor="@color/white"
        android:textOff="незаливати"
        android:textOn="заливка"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <Button
        android:id="@+id/buttonClear2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/workbutton"
        android:onClick="ClearScreen"
        android:text="очистити"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleFill" />

    <Button
        android:id="@+id/resetButton4"
        android:layout_width="103dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/workbutton"
        android:onClick="ResetModeButton"
        android:text="режим"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
        app:layout_constraintStart_toEndOf="@+id/customView" />

    <com.example.testdrawsurface.CustomView
        android:id="@+id/customView"
        android:layout_width="370dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:rotation="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/customView"
        app:layout_constraintTop_toTopOf="parent">

        <SeekBar
            android:id="@+id/redBar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:max="255"
            android:progressBackgroundTint="#FF0000"
            android:progressTint="#FF0000"
            android:scrollbarSize="8dp"
            android:thumbTint="#FF0000" />

        <SeekBar
            android:id="@+id/greenBar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:max="255"
            android:progressBackgroundTint="#43FA00"
            android:progressTint="#43FA00"
            android:rotation="0"
            android:thumbTint="#43FA00" />

        <SeekBar
            android:id="@+id/blueBar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:max="255"
            android:progressBackgroundTint="#0360FF"
            android:progressTint="#0360FF"
            android:thumbTint="#0360FF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>