<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TetrisActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <Button
                android:id="@+id/upButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:onClick="UpButton"
                android:text="вверх"
                android:textSize="32sp" />

            <LinearLayout
                android:id="@+id/linearLayout4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/leftButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:onClick="RightButton"
                    android:text="вліво"
                    android:textSize="32sp" />

                <Button
                    android:id="@+id/rightButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:onClick="LeftButton"
                    android:text="право"
                    android:textSize="32sp" />
            </LinearLayout>

            <Button
                android:id="@+id/downButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:onClick="DownButton"
                android:text="вниз"
                android:textSize="32sp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <Button
                android:id="@+id/tetrisResetButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/workbutton"
                android:onClick="TetrisModeButton"
                android:text="Тетріс"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/snakeResetButton"
                app:layout_constraintEnd_toEndOf="@+id/snakeResetButton"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/snakeResetButton" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:layout_marginEnd="40dp"
                android:onClick="BackButton"
                android:text="Назад"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/snakeResetButton"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/snakeResetButton"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="36dp"
                android:backgroundTint="@color/workbutton"
                android:onClick="SnakeModeButton"
                android:text="Змійка"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>